<Page x:Class="TimeTracker.Desktop.Views.TodayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      Title="TodayPage">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32">

            <!-- כותרת וכפתור רענון -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="היום" FontSize="32" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DateText}" FontSize="14" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ui:Button Grid.Column="1" Content="רענון" VerticalAlignment="Center"
                           Icon="{ui:SymbolIcon ArrowSync24}"
                           Command="{Binding RefreshCommand}" />
            </Grid>

            <!-- הודעת שגיאה -->
            <ui:InfoBar Title="אין חיבור לשרת" Message="ה-API לא זמין. ודאי שהוא פועל."
                        Severity="Warning" IsClosable="False"
                        IsOpen="{Binding HasError}" Margin="0,16,0,0" />

            <!-- עכשיו פעיל -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <ui:SymbolIcon Symbol="Record24" Foreground="#E53935" Margin="0,0,8,0" />
                <TextBlock Text="עכשיו פעיל: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding CurrentApp}" FontWeight="SemiBold" />
            </StackPanel>

            <!-- כרטיסי סיכום -->
            <UniformGrid Columns="3" Margin="-6,20,-6,0">
                <ui:Card Margin="6">
                    <StackPanel>
                        <TextBlock Text="סה&quot;כ זמן מול המחשב"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding TotalTime}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="6">
                    <StackPanel>
                        <TextBlock Text="זמן פרודוקטיבי"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding ProductiveTime}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="6">
                    <StackPanel>
                        <TextBlock Text="אחוז מיקוד"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding FocusPercent}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0" />
                    </StackPanel>
                </ui:Card>
            </UniformGrid>
            <!-- לפי קטגוריה -->
<TextBlock Text="לפי קטגוריה" FontSize="20" FontWeight="SemiBold" Margin="0,32,0,12" />
<ui:Card>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <lvc:PieChart Series="{Binding CategorySeries}" Height="240"
                      TooltipPosition="Hidden" LegendPosition="Hidden" />

        <ItemsControl Grid.Column="1" ItemsSource="{Binding Categories}"
                      VerticalAlignment="Center" Margin="24,0,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="12" Height="12" Fill="{Binding Color}"
                                 VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Time}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="16,0" />
                        <TextBlock Grid.Column="3" Text="{Binding Percent}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</ui:Card>
            <!-- לפי קטגוריה -->
            <TextBlock Text="לפי קטגוריה" FontSize="20" FontWeight="SemiBold" Margin="0,32,0,12" />
            <ui:Card>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <lvc:PieChart Series="{Binding CategorySeries}" Height="240"
                      TooltipPosition="Hidden" LegendPosition="Hidden" />

                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Categories}"
                      VerticalAlignment="Center" Margin="24,0,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="12" Height="12" Fill="{Binding Color}"
                                 VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Time}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="16,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding Percent}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ui:Card>

            <!-- רשימת תוכנות -->
            <TextBlock Text="תוכנות" FontSize="20" FontWeight="SemiBold" Margin="0,32,0,12" />
            <ui:Card>
                <ItemsControl ItemsSource="{Binding Apps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Category}" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ProgressBar Grid.Column="1" Value="{Binding Percent}" Maximum="100"
                                             Height="6" VerticalAlignment="Center" Margin="16,0" />
                                <TextBlock Grid.Column="2" Text="{Binding Time}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</Page>