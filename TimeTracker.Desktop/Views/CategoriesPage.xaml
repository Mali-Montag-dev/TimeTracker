<Page x:Class="TimeTracker.Desktop.Views.CategoriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="CategoriesPage">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32">

            <!-- כותרת -->
            <TextBlock Text="קטגוריות" FontSize="32" FontWeight="SemiBold" />
            <TextBlock Text="קבצי את התוכנות שלך לקבוצות, וסמני אילו מהן נחשבות לזמן פרודוקטיבי."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />

            <!-- הודעת שגיאה -->
            <ui:InfoBar Title="שגיאה" Message="{Binding ErrorMessage}" Severity="Error"
                        IsOpen="{Binding HasError}" IsClosable="False" Margin="0,16,0,0" />

            <!-- טופס -->
            <ui:Card Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding FormTitle}" FontSize="18" FontWeight="SemiBold" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox PlaceholderText="שם הקטגוריה"
                                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                        <ComboBox Grid.Column="1" Width="90" Margin="12,0"
                                  ItemsSource="{Binding ColorOptions}"
                                  SelectedItem="{Binding SelectedColor}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Ellipse Width="18" Height="18" Fill="{Binding}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <ui:ToggleSwitch Grid.Column="2" Content="פרודוקטיבי"
                                         IsChecked="{Binding IsProductive}" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <ui:Button Content="{Binding SaveButtonText}" Appearance="Primary"
                                   Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveCommand}" />
                        <ui:Button Content="ביטול" Margin="8,0,0,0" Command="{Binding CancelCommand}"
                                   Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- רשימה -->
            <TextBlock Text="הקטגוריות שלי" FontSize="20" FontWeight="SemiBold" Margin="0,32,0,12" />

            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Ellipse Width="14" Height="14" Fill="{Binding Color}"
                                         VerticalAlignment="Center" Margin="0,0,12,0" />

                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="16"
                                           VerticalAlignment="Center" />

                                <Border Grid.Column="2" CornerRadius="10" Padding="10,2" Margin="12,0"
                                        Background="#264CAF50" VerticalAlignment="Center"
                                        Visibility="{Binding IsProductive, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="פרודוקטיבי" FontSize="12" Foreground="#43A047" />
                                </Border>

                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <ui:Button Icon="{ui:SymbolIcon Edit24}" Appearance="Transparent" ToolTip="עריכה"
                                               Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent" ToolTip="מחיקה"
                                               Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>