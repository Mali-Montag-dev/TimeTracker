        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimeTracker" Height="220" Width="450"
        FlowDirection="RightToLeft">
    <StackPanel Margin="20">
        <TextBlock Text="עכשיו פעיל:" FontSize="14" Foreground="Gray"/>
        <TextBlock x:Name="CurrentAppText" Text="..." FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
        <TextBlock x:Name="StatusText" Text="מתחיל..." Foreground="Gray" Margin="0,20,0,0"/>
    </StackPanel>
</Window>